# Scout — backend environment secrets.
# Copy this to `.env` and fill in your keys. NEVER commit `.env`.
#
# The backend auto-loads .env at startup (see backend/config.py).
# The frontend never sees these — it uses frontend/.env.local instead.

# ─── NVIDIA NIM — the primary brain (REQUIRED) ─────────────────────────
# Powers all selectable models: nemotron-3-ultra, gpt-oss-20b,
# nemotron-super-49b, nemotron-nano-omni, llama-3.2-11b-vision.
# Free tier available. Get a key at https://build.nvidia.com →
#   sign in → top-right profile → "API Keys" → "Generate API Key".
# Starts with "nvapi-".
NVIDIA_API_KEY=

# ─── Z.AI (optional) — direct source for GLM-5.2 ───────────────────────
# Only needed if you want to select GLM-5.2 in the model catalog.
# Key format: <id>.<secret>. Requires paid balance at https://z.ai.
# Leave blank if you only use NVIDIA models.
ZAI_API_KEY=

# ─── Supabase (optional) — persistent memory & conversation history ────
# If unset, Scout falls back to localStorage-only history and disables
# the persistent memory system. To enable, create a free project at
# https://supabase.com and run the SQL in docs/supabase-schema.sql.
SUPABASE_URL=
SUPABASE_KEY=

# ─── Optional integrations ─────────────────────────────────────────────
# Spotify client id lives in config/jarvis.json; only the SECRET goes here.
SPOTIFY_CLIENT_SECRET=

# Home Assistant long-lived access token (smart-home control).
HOME_ASSISTANT_TOKEN=

# Giphy (optional) — animated GIFs in chat. If unset, the GIF picker shows
# a friendly setup prompt and the send_gif tool returns an honest error.
# Get a free key: https://developers.giphy.com → Create App → API Key
# (Tenor is no longer accepting new API clients as of Jan 2026.)
GIPHY_API_KEY=
# Optional: content rating — g | pg | pg-13 | r. Default pg-13.
GIPHY_RATING=

# ─── Notes ─────────────────────────────────────────────────────────────
# Non-secret config (model IDs, ports, wake word, weather city) lives in
# config/jarvis.json — edit it there, not here.
#
# Google OAuth credentials for Gmail/Calendar go in
# config/google_credentials.json (see README for setup).
