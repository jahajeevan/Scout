# Scout — frontend environment. Copy to `.env.local` and fill in.
# NEXT_PUBLIC_* values are bundled into the browser build (never put
# secrets here — only publishable/anon keys).

# Backend server (default: local dev)
NEXT_PUBLIC_BACKEND_PORT=8000

# Personalisation — how Scout addresses you in the UI
NEXT_PUBLIC_USER_NAME=Jeev

# Supabase (optional — enables cross-device history + memory sync).
# Use the PUBLISHABLE (anon) key, not the service role. Get both at
# https://supabase.com → your project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
